# chktex rules for prose-heavy LaTeX.
#
# Stock chktex is tuned for a different job and fires constantly on ordinary
# academic writing. Left as shipped, its output is noise, and noise in an
# editor's gutter trains people to ignore the gutter -- which costs more
# than the warnings are worth.
#
# What stays on: the things that silently produce wrong output.
#
# Format notes, both of which this file got wrong for its whole life and
# which cost the lint feature entirely -- chktex refused to start, printed
# one line on stderr, and the app read its empty stdout as "nothing to
# report":
#
#   * There is no `WarnOff'/`WarnOn'.  Warnings are turned off with `-n<n>'
#     inside CmdLine, and everything not turned off is already on.
#   * List items are separated by SPACES, not commas.  `{ e.g., i.e. }' is
#     two items named "e.g.," and "i.e." -- neither of which ever matches.
#   * A list written without `=' appends to the stock list rather than
#     replacing it, which is what these want.
#
# The numbers below were checked against chktex 1.7.9 by provoking each one
# and reading `%n' out of its own output; `tests/test_lint_explain.py' does
# the same for every warning this project explains in English, so a chktex
# that renumbers fails the suite rather than mislabelling a warning.

CmdLine
{
    # 1  "Command terminated with space"        -- fires on every \LaTeX\ use
    -n1
    # 8  "Wrong length of dash"                 -- wrong about ranges in maths
    -n8
    # 11 "You should use \ldots"                -- style, not correctness
    -n11
    # 17 "Number of `character' does not match" -- false on mhchem and siunitx
    -n17
    # 18 "Use `` or '' for quotes"              -- wrong inside verbatim and urls
    -n18
    # 22 "Comment displayed"                    -- commented-out outlines are
    #                                              a normal way to draft
    -n22
    # 30 "Multiple spaces detected"             -- alignment in tabulars
    -n30
    # 36                                        -- unidentified: chktex 1.7.9
    #                                              would not report it under
    #                                              any input tried, even with
    #                                              -w36, so the description
    #                                              this line used to carry
    #                                              could not be confirmed and
    #                                              has been removed rather
    #                                              than repeated. The mute
    #                                              costs nothing while that
    #                                              is true.
    -n36
    # 44 "User-specified pattern"               -- nothing specified
    -n44
}

# Abbreviations that legitimately end in a period mid-sentence, so the
# inter-sentence spacing check does not fire on them.  Single tokens only:
# chktex matches the word before the period, so "et al." is listed as "al.".
Abbrev
{
    e.g. i.e. cf. al. etc. vs. approx. ca. viz. resp. Fig. Figs. Eq. Eqs.
    Ref. Refs. Sec. Secs. Ch. Chs. Tab. App. Eqn. Eqns.
}

# Verbatim-like environments whose contents are not LaTeX.  Appended to the
# stock list, which already carries verbatim, lstlisting and minted.
VerbEnvir
{
    Verbatim alltt
}

# Maths environments: quoting and dash rules do not apply inside them.
MathEnvir
{
    math displaymath equation eqnarray align gather multline
    alignat split array matrix pmatrix bmatrix cases
}

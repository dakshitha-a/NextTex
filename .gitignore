
*.crt
.env
examples/**/build/
# Frontend
frontend/dist/
frontend/node_modules
frontend/.vite/
*.key
# LaTeX build output from the example project
.nexttex-preview.tex
node_modules
*.pem
*.pyc
__pycache__/
# Python
# Runtime state (per-install, never committed).  `.nexttex/` holds a
# project's version history, its trash, its agent transcript and the id of
# the Claude session that produced it -- none of which belongs to anyone
# but the person who wrote it, and all of which was once committed here by
# accident along with the example project.
.nexttex/
examples/**/.nexttex/
.venv
venv/

# Browser tests
# Renders from e2e/shots are for looking at, not for committing.  The two
# the README uses live in docs/ and are written there deliberately.
e2e/shots/*.png
# The sweep renders every surface at every breakpoint in both themes --
# seventy-odd files per run, for a person to go through and then discard.
e2e/shots/sweep/
# And the same for the pass renders: the surfaces one change touched,
# photographed to be judged and then thrown away.
e2e/shots/pass/
e2e/node_modules
e2e/test-results/
e2e/playwright-report/
frontend/node_modules
bench/report/

# uv, when the installer fetched its own rather than using one on PATH.
# Kept inside the install so deleting the folder really does uninstall it.
.uv/

# Local test caches.
.hypothesis/
.pytest_cache/

# Claude Code's own worktrees for parallel sessions; the skills, hooks and
# settings beside them are committed, these are not.
.claude/worktrees/
# Plan files, and the per-session marker that says one is being executed;
# see .claude/hooks/plan_amendment.py.
.claude/plans/
.claude/plan-in-progress/
# The per-machine companions Claude Code reads beside the tracked files and
# never commits: where this machine keeps a newer Node, which account gh is
# signed in as, and the permissions one person has granted.
CLAUDE.local.md
.claude/settings.local.json
